{
  "manifest_version": 3,
  "name": "Quick Project Links",
  "version": "1.13.0",
  "description": "Log Relayを追加。Alt+Spaceで時刻＋1行メモを保存し、サイドパネル内で未処理・保留・完了を整理できる版",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "activeTab",
    "tabs",
    "notifications"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "32": "icons/icon32.png"
  },
  "action": {
    "default_title": "Quick Links",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background-wrapper.js"
  },
  "side_panel": {
    "default_path": "sidepanel-wrapper.html"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "auto-project-rules.js",
        "content-floating-search.js",
        "log-relay-capture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "quick-links-open-links": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "右下POPをLinksタブで開く"
    },
    "quick-links-open-reds": {
      "suggested_key": {
        "default": "Alt+2"
      },
      "description": "右下POPをRedsタブで開く"
    },
    "quick-links-open-prompts": {
      "suggested_key": {
        "default": "Alt+3"
      },
      "description": "右下POPをPromptタブで開く"
    },
    "quick-links-clear-search": {
      "description": "検索語をクリアし、現在の検索欄へ移動する"
    },
    "quick-links-add-log": {
      "suggested_key": {
        "default": "Alt+Space"
      },
      "description": "Log Relayへ1行メモを追加する"
    }
  }
}
